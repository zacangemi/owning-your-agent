# Hermes Agent environment variables
# Copy this file to ~/.hermes/.env and fill in your own values.
# NEVER commit your actual .env to a repo.

# === Required: Local inference endpoint ===
# Match these to your llama.cpp server. The OPENAI_BASE_URL is what Hermes
# talks to for inference — replace with your Tailscale IP, LAN IP, or localhost.
OPENAI_BASE_URL=http://<your-inference-host>:8000/v1
OPENAI_API_KEY=not-needed

# Required: model name as your llama.cpp endpoint reports it
LLM_MODEL=Qwen3.5-27B-UD-Q5_K_XL.gguf

# === Required: Prevents OpenRouter routing bug ===
# Hermes has an open bug (#2602) where local-provider requests can silently route
# to OpenRouter if this isn't set. Any placeholder string works for local-only use.
OPENROUTER_API_KEY=sk-placeholder-not-used-for-local

# === Required if web.backend: tavily in config.yaml ===
# Get free API key at https://tavily.com — 1000 searches/month free tier
TAVILY_API_KEY=your-tavily-key-here

# === Optional: Telegram bot for mobile access ===
# Set up via @BotFather on Telegram, then run: hermes gateway install
TELEGRAM_BOT_TOKEN=your-bot-token-here
TELEGRAM_ALLOWED_USERS=your-telegram-user-id

# === Optional: Other Hermes integrations (uncomment as needed) ===
# DISCORD_BOT_TOKEN=
# SLACK_BOT_TOKEN=
# FAL_KEY=                  # for image generation (paid)
# BROWSERBASE_API_KEY=      # for cloud browser (free tier)
